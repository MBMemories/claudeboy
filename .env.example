# ===== Gold Price Data Source =====
# โหมดข้อมูล: "mock" (ค่าเริ่มต้น) หรือ "live"
NEXT_PUBLIC_DATA_MODE=mock

# ===== Live API (เลือกใช้เมื่อ NEXT_PUBLIC_DATA_MODE=live) =====
# GoldAPI.io  -> https://www.goldapi.io
GOLDAPI_KEY=

# Metals-API -> https://metals-api.com
METALS_API_KEY=

# Alpha Vantage -> https://www.alphavantage.co
ALPHA_VANTAGE_KEY=

# ผู้ให้บริการที่จะใช้: goldapi | metals-api | alpha-vantage
GOLD_PROVIDER=goldapi
