# ===== Gold Price Data Source =====
# โหมดข้อมูล: "live" (ค่าเริ่มต้น = ราคาจริง) หรือ "mock" (ราคาจำลอง)
# โหมด live ใช้แหล่งฟรีไม่ต้องใช้ key อยู่แล้ว (gold-api.com + open.er-api.com)
NEXT_PUBLIC_DATA_MODE=live

# ===== (ทางเลือก) ใช้ provider แบบมี API key แทนแหล่งฟรี =====
# ตั้ง GOLD_PROVIDER เป็นหนึ่งใน: goldapi | metals-api | alpha-vantage
# แล้วใส่ key ให้ตรงกับ provider นั้น  (เว้นว่าง = ใช้แหล่งฟรี)
GOLD_PROVIDER=free

# GoldAPI.io  -> https://www.goldapi.io
GOLDAPI_KEY=

# Metals-API -> https://metals-api.com
METALS_API_KEY=

# Alpha Vantage -> https://www.alphavantage.co
ALPHA_VANTAGE_KEY=
